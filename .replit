modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["python", "-m", "pip", "install", "-r", "requirements-deploy.txt"]
run = ["python", "scripts/run_demo.py", "--published"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Run MedFlow"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run MedFlow"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libsndfile", "libtiff", "libwebp", "libxcrypt", "openjpeg", "portaudio", "postgresql", "tcl", "tk", "zlib"]

[userenv]

[userenv.development]
APP_ENV = "development"
DEMO_PROFILES_ENABLED = "true"
MOCK_OTP_ENABLED = "false"
SHOW_DEV_OTP = "false"
STORAGE_BACKEND = "postgres"
