modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = ["python", "-m", "pip", "install", "-r", "requirements-deploy.txt"]
run = ["python", "scripts/run_demo.py", "--published"]

[workflows]
runButton = "Run MedFlow"

[[workflows.workflow]]
name = "Run MedFlow"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_demo.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libsndfile", "libtiff", "libwebp", "libxcrypt", "openjpeg", "portaudio", "tcl", "tk", "zlib"]

[userenv]

[userenv.development]
APP_ENV = "demo"
DEMO_PROFILES_ENABLED = "true"
MOCK_OTP_ENABLED = "false"
SHOW_DEV_OTP = "false"
STORAGE_BACKEND = "postgres"
