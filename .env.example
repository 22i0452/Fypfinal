# Copy this file to .env and fill in only the keys you actually use.

# Core LLM + STT
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
MODULE2_STT_PROVIDER=openrouter
MODULE2_GROQ_STT_MODEL=whisper-large-v3
MODULE2_OPENROUTER_STT_MODEL=openai/gpt-4o-transcribe
MODULE2_OPENROUTER_WHISPER_MODEL=openai/whisper-large-v3
MODULE2_OPENAI_STT_MODEL=whisper-1
TRANSCRIPT_CLEANUP_PROVIDER=openrouter
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
GROQ_LLM_MODEL=qwen/qwen3.8-27b
DIARIZATION_PROVIDER=openai
GROQ_DIARIZATION_MODEL=qwen/qwen3.8-27b
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_DIARIZATION_MODEL=gpt-4o-mini
MEDFLOW_LLM_PROVIDER=openai

# Optional providers
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TTS_API_KEY=
HF_TTS_VOICE_ID=
HF_TOKEN=

# Web session config
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=medflow_session
SESSION_MAX_AGE_SECONDS=28800

# Application and development verification
APP_ENV=development
MOCK_OTP_ENABLED=true
SHOW_DEV_OTP=false
OTP_SECRET=change-me-too
OTP_EXPIRY_SECONDS=300
OTP_LOCK_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5

# Authenticates the separate receptionist process to the canonical FastAPI server.
# Development has a local default; production requires a unique 32+ character value.
MEDFLOW_RECEPTIONIST_SERVICE_TOKEN=
MEDFLOW_API_BASE_URL=http://127.0.0.1:8000
PRIMARY_DOCTOR_EMAIL=
PRIMARY_DOCTOR_DISPLAY_NAME=Dr. Shahzaib Ali Khan

# Local-only shortcut for seeded PT-DEMO-SYNTHETIC-* records; refused outside development
DEVELOPMENT_QUICK_START_ENABLED=true

# Feature and storage configuration
STORAGE_BACKEND=json
PREVISIT_SUMMARY_ENABLED=true
FHIR_ENABLED=false
ICD_CODING_ENABLED=true
MEDFLOW_AUDIO_RETENTION_ENABLED=false
MEDFLOW_AUDIO_RETENTION_DIR=scribe/retained_audio
